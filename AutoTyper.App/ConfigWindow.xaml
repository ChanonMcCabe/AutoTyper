<ui:FluentWindow x:Class="AutoTyper.App.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoTyper.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings" Height="580" Width="500" MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="12,4,12,0">
            <TabItem Header="Appearance">
                <local:AppearancePanel x:Name="AppearancePanel" />
            </TabItem>
            <TabItem Header="General">
                <local:SettingsPanel x:Name="GeneralPanel" />
            </TabItem>
            <TabItem Header="Typing">
                <local:SettingsPanel x:Name="TypingPanel" />
            </TabItem>
            <TabItem Header="Advanced">
                <local:SettingsPanel x:Name="AdvancedPanel" />
            </TabItem>
        </TabControl>

        <ui:InfoBar Grid.Row="2" x:Name="ErrorText" Severity="Error" IsClosable="False"
                    Title="Invalid settings" Margin="12,8,12,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <ui:Button Content="Save" Appearance="Primary" MinWidth="90" Margin="0,0,8,0"
                       Click="SaveButton_Click" IsDefault="True" />
            <ui:Button Content="Cancel" MinWidth="90" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
