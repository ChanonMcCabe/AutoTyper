<UserControl x:Class="AutoTyper.App.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,12,4,4">

            <ui:Card Margin="0,0,0,10">
                <StackPanel>
                    <ui:TextBlock Text="Appearance" FontTypography="BodyStrong" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <ui:TextBlock Text="Theme" />
                            <ui:TextBlock Text="Follow the Windows app mode, or force light or dark."
                                          Appearance="Tertiary" FontTypography="Caption" TextWrapping="Wrap"
                                          Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ThemeCombo" Width="140" VerticalAlignment="Center"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock Text="Window" FontTypography="BodyStrong" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <ui:TextBlock Text="Always on top" />
                            <ui:TextBlock Text="Keep the AutoTyper window above other windows."
                                          Appearance="Tertiary" FontTypography="Caption" TextWrapping="Wrap"
                                          Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
