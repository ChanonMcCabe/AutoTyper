<ui:FluentWindow x:Class="AutoTyper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoTyper.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        Title="AutoTyper" Height="560" Width="500" MinWidth="440" MinHeight="520"
        Icon="Assets/AppIcon.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        StateChanged="Window_StateChanged" Closing="Window_Closing">
    <ui:FluentWindow.Resources>
        <ContextMenu x:Key="TrayContextMenu">
            <MenuItem Header="Restore" Click="RestoreMenuItem_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AutoTyper">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:Card Grid.Row="1" Margin="16,4,16,8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Text="Passage" FontTypography="BodyStrong" Margin="0,0,0,6" />
                <TextBox Grid.Row="1"
                         Text="{Binding PassageText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12" MinHeight="120" />

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Text="WPM" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" VerticalAlignment="Center"
                             Text="{Binding EditableWpm, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsWpmFieldEnabled}" />
                    <ui:TextBlock Grid.Column="3" Text="Hotkey" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <local:HotkeyCaptureBox x:Name="HotkeyDisplay" Grid.Column="4" />
                </Grid>

                <ui:TextBlock Grid.Row="3" Text="{Binding ModeText}"
                              FontTypography="Caption" Appearance="Tertiary" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="Save" Appearance="Secondary" MinWidth="88" Margin="0,0,8,0"
                           Command="{Binding SaveSettingsCommand}" />
                <ui:Button Content="Cancel" MinWidth="88"
                           Command="{Binding CancelSettingsCommand}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Settings" Icon="{ui:SymbolIcon Settings24}"
                       Click="SettingsButton_Click" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,10">
            <ui:Button Content="Activate" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                       MinWidth="96" Margin="0,0,8,0" Command="{Binding ActivateCommand}" />
            <ui:Button Content="Deactivate" MinWidth="96" Margin="0,0,8,0"
                       Command="{Binding DeactivateCommand}" />
            <ui:Button Content="Stop Typing" Icon="{ui:SymbolIcon Stop24}" MinWidth="96"
                       Command="{Binding StopTypingCommand}" />
        </StackPanel>

        <ui:TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="16,0,16,14"
                      FontTypography="Caption" Appearance="Tertiary" TextWrapping="Wrap" />

        <tb:TaskbarIcon x:Name="TrayIcon"
                         ToolTipText="AutoTyper"
                         IconSource="pack://application:,,,/Assets/AppIcon.ico"
                         ContextMenu="{StaticResource TrayContextMenu}"
                         TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick" />
    </Grid>
</ui:FluentWindow>
