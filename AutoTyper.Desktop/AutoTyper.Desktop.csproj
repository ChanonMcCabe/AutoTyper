<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutoTyper.Desktop</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!-- Cross-compiling the macOS build from Windows needs both RIDs declared. -->
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to the Avalonia 11 line rather than 12, and FluentAvalonia to 2.4.0.
      Both newer lines (Avalonia 12, FluentAvalonia 2.5.1+ and 3.x) require
      net10.0, which would split this project off from the rest of the
      solution's net8.0 target. 2.4.0 is the newest FluentAvalonia that still
      supports net8.0.
    -->
    <PackageReference Include="Avalonia" Version="11.3.21" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.21" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.21" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.21" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoTyper.Core\AutoTyper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets AutoTyper.Desktop.Tests assert struct layout and four-char-code
         arithmetic in the internal Carbon P/Invoke declarations without
         making them public. -->
    <InternalsVisibleTo Include="AutoTyper.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
