<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="AutoTyper.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <sty:FluentAvaloniaTheme />
    </Application.Styles>

    <!--
        Unlike WPF, Avalonia hangs the tray icon off the Application rather than
        a window. On macOS this becomes a menu-bar status item, which responds to
        a single click rather than a double click, so the menu is the only
        interaction wired up here.
    -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://AutoTyper.Desktop/Assets/AppIcon.ico"
                      ToolTipText="AutoTyper"
                      Clicked="TrayIcon_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Restore" Click="RestoreMenuItem_Click" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="ExitMenuItem_Click" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
