<Styles xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- TextBox template with 3D beveled effect (sunken appearance) -->
    <Style Selector="TextBox">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Outer border: dark top/left (shadow) -->
                <Border BorderBrush="#808080" BorderThickness="1,1,0,0" CornerRadius="0">
                    <!-- Inner border: light bottom/right (highlight) -->
                    <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1" CornerRadius="0"
                            Background="{TemplateBinding Background}">
                        <!-- Text input area (wrapped in border for padding) -->
                        <Border Padding="{TemplateBinding Padding}">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch" />
                        </Border>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- TextBox PointerOver state -->
    <Style Selector="TextBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
    </Style>

    <!-- TextBox Focused state -->
    <Style Selector="TextBox:focus">
        <Setter Property="Background" Value="{DynamicResource TextControlBackgroundFocused}" />
    </Style>

    <!-- TextBox Disabled state -->
    <Style Selector="TextBox:disabled">
        <Setter Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
    </Style>

    <!-- 3D Beveled Button: raised with light top/left borders, becomes sunken when pressed -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Button template with 3D effect -->
    <Style Selector="Button">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Raised state: light top/left, dark bottom/right -->
                <Border x:Name="PART_Border"
                        BorderBrush="#C0C0C0"
                        BorderThickness="1,1,0,0"
                        CornerRadius="0"
                        Background="{TemplateBinding Background}">
                    <Border BorderBrush="#808080" BorderThickness="0,0,1,1" CornerRadius="0">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Button PointerOver state: slightly darker raised appearance -->
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
    </Style>

    <!-- Button Pressed state: inverted to sunken (dark top/left, light bottom/right) -->
    <Style Selector="Button:pressed /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="#808080" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
    </Style>

    <Style Selector="Button:pressed /template/ Border#PART_Border > Border">
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
    </Style>

    <!-- Button Disabled state -->
    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
    </Style>

    <!-- Custom CheckBox with corrected glyph centering and 3D box appearance -->
    <Style Selector="CheckBox">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUnchecked}" />
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUnchecked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUnchecked}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- CheckBox template -->
    <Style Selector="CheckBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                        <!-- CheckBox box with 3D effect -->
                        <Border Grid.Column="0"
                                Width="14"
                                Height="14"
                                Margin="0,0,8,0"
                                BorderBrush="#808080"
                                BorderThickness="1,1,0,0"
                                CornerRadius="0"
                                VerticalAlignment="Center">
                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                <Border x:Name="PART_CheckBoxBox"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0">
                                    <!-- Grid to hold both glyph variants (only one visible at a time) -->
                                    <Grid>
                                        <!-- Checkmark glyph (only visible when checked) -->
                                        <TextBlock x:Name="CheckGlyph"
                                                   Text="✓"
                                                   Foreground="{DynamicResource CheckBoxCheckGlyphForegroundUnchecked}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="False" />

                                        <!-- Indeterminate glyph (only visible when indeterminate) -->
                                        <TextBlock x:Name="IndeterminateGlyph"
                                                   Text="▪"
                                                   Foreground="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminate}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="False" />
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>

                        <!-- Label text -->
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- CheckBox Unchecked states -->
    <Style Selector="CheckBox:unchecked">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUnchecked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUnchecked}" />
    </Style>

    <Style Selector="CheckBox:unchecked:pointerover">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUncheckedPointerOver}" />
    </Style>

    <!-- Hide glyphs when unchecked -->
    <Style Selector="CheckBox:unchecked /template/ TextBlock#CheckGlyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CheckBox:unchecked /template/ TextBlock#IndeterminateGlyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- CheckBox Checked states -->
    <Style Selector="CheckBox:checked">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundChecked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushChecked}" />
    </Style>

    <!-- Show checkmark glyph when checked -->
    <Style Selector="CheckBox:checked /template/ TextBlock#CheckGlyph">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" />
    </Style>

    <!-- Hide indeterminate glyph when checked -->
    <Style Selector="CheckBox:checked /template/ TextBlock#IndeterminateGlyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CheckBox:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundCheckedPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushCheckedPointerOver}" />
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ TextBlock#CheckGlyph">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPointerOver}" />
    </Style>

    <Style Selector="CheckBox:checked:pressed /template/ TextBlock#CheckGlyph">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPressed}" />
    </Style>

    <!-- CheckBox Indeterminate states -->
    <Style Selector="CheckBox:indeterminate">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundIndeterminate}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushIndeterminate}" />
    </Style>

    <!-- Show indeterminate glyph when indeterminate -->
    <Style Selector="CheckBox:indeterminate /template/ TextBlock#IndeterminateGlyph">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminate}" />
    </Style>

    <!-- Hide checkmark glyph when indeterminate -->
    <Style Selector="CheckBox:indeterminate /template/ TextBlock#CheckGlyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CheckBox:indeterminate:pointerover">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundIndeterminatePointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushIndeterminatePointerOver}" />
    </Style>

    <Style Selector="CheckBox:indeterminate:pointerover /template/ TextBlock#IndeterminateGlyph">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminatePointerOver}" />
    </Style>

    <Style Selector="CheckBox:indeterminate:pressed /template/ TextBlock#IndeterminateGlyph">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminatePressed}" />
    </Style>

    <!-- CheckBox Disabled state -->
    <Style Selector="CheckBox:disabled">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUncheckedDisabled}" />
    </Style>

</Styles>
