<!--
    AhkClassic: flat Windows 10 WinForms look (see ThemeManager.ApplyAhkClassicTheme for the palette).
    Buttons, TextBoxes, ComboBoxes, etc. keep FluentAvalonia's templates and are recolored through
    resource keys; only geometry (thin borders, small padding) is overridden here. CheckBox and
    RadioButton get small custom templates because WinForms glyphs differ from Fluent's.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Segoe UI 9pt (12px). Avalonia falls back to the default font family where Segoe UI is absent (macOS). -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource ApplicationPageBackgroundThemeBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Tab headers: Fluent's are 28px; WinForms tabs use the normal dialog font. -->
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinHeight" Value="22" />
    </Style>

    <!-- Group box: flat square card with a 1px light border. -->
    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ========== CheckBox ========== -->
    <Style Selector="CheckBox">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUnchecked}" />
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUnchecked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUnchecked}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border x:Name="PART_Box"
                                Width="13" Height="13"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <TextBlock x:Name="CheckGlyph" Text="✓" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource CheckBoxCheckGlyphForegroundChecked}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="False" />
                                <Border x:Name="IndeterminateGlyph" Width="7" Height="7"
                                        Background="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminate}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="False" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox:checked /template/ TextBlock#CheckGlyph">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox:indeterminate /template/ Border#IndeterminateGlyph">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="CheckBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUncheckedPointerOver}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedPointerOver}" />
    </Style>
    <Style Selector="CheckBox:pressed">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedPressed}" />
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUncheckedDisabled}" />
    </Style>
    <Style Selector="CheckBox:disabled /template/ TextBlock#CheckGlyph">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedDisabled}" />
    </Style>

    <!-- ========== RadioButton ========== -->
    <Style Selector="RadioButton">
        <Setter Property="Background" Value="{DynamicResource RadioButtonBackgroundUnchecked}" />
        <Setter Property="Foreground" Value="{DynamicResource RadioButtonForegroundUnchecked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RadioButtonBorderBrushUnchecked}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Grid Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse x:Name="OuterEllipse"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="CheckGlyph" Width="5" Height="5"
                                     Fill="{DynamicResource RadioButtonCheckGlyphForegroundChecked}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="False" />
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource RadioButtonBorderBrushUncheckedPointerOver}" />
    </Style>
    <Style Selector="RadioButton:pressed">
        <Setter Property="Background" Value="{DynamicResource RadioButtonBackgroundUncheckedPressed}" />
    </Style>
    <Style Selector="RadioButton:disabled">
        <Setter Property="Background" Value="{DynamicResource RadioButtonBackgroundUncheckedDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource RadioButtonForegroundUncheckedDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RadioButtonBorderBrushUncheckedDisabled}" />
    </Style>
    <Style Selector="RadioButton:disabled /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource RadioButtonCheckGlyphForegroundCheckedDisabled}" />
    </Style>

</Styles>
